# Node64 als Systemdienst (Paket node64). Eigene Anpassungen nicht hier, sondern mit "systemctl edit node64"
# (Drop-in), Einstellungen in /etc/default/node64.
[Unit]
Description=Node64 (ipv64.net) - Healthchecks, DNS64, PROXY64, Monitor64 und mehr
Documentation=https://node64.de/docs/
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=node64
Group=node64
EnvironmentFile=-/etc/default/node64
ExecStart=/usr/bin/node64
Restart=on-failure
RestartSec=5s
# Daten in /var/lib/node64 (legt systemd mit dem Benutzer an); neuere Versionen aus dem Selbst-Update liegen dort in bin/
StateDirectory=node64
StateDirectoryMode=0750
WorkingDirectory=/var/lib/node64
# Ports unter 1024 (DNS 53, DHCP 67, PROXY64 80/443, Fallen von Honeypot64), Ping und Router Advertisements,
# Firewall-Helfer (nftables): dieselben Rechte wie das Docker-Image; gelten auch fuer Versionen aus dem Selbst-Update
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
UMask=0027
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
