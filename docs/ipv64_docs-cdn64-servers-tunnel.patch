 		<tr><td>Bandwidth (all servers together)</td><td>50 Mbit/s</td><td>1 Gbit/s</td><td>unlimited</td><td>unlimited</td></tr>
-		<tr><td>Edge servers (<a href="#server-je-konto">servers per account</a>)</td><td>1</td><td>2</td><td>1–2, your choice</td><td>1 to all, your choice</td></tr>
