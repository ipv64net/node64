 		<tr><td>Bandwidth (all servers together)</td><td>50 Mbit/s</td><td>1 Gbit/s</td><td>unlimited</td><td>unlimited</td></tr>
-		<tr><td>Edge servers per tunnel (<a href="#server-je-tunnel">servers per tunnel</a>)</td><td>1</td><td>2</td><td>1–2, your choice</td><td>1 to all, your choice</td></tr>
+		<tr><td>Edge servers per name (<a href="#server-je-name">servers per name</a>)</td><td>1</td><td>2</td><td>1–2, your choice</td><td>1 to all, your choice</td></tr>
 		<tr><td>Tunnel connections per server</td><td>1</td><td>1</td><td>1–2, your choice</td><td>1–4, your choice</td></tr>
