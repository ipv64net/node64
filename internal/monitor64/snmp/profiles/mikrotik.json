          "min": 0,
          "max": 100000
        }
      ]
    },
    {
      "key": "poe:{name}",
      "service": "PoE {name}",
      "kind": "poe",
      "oid": ".1.3.6.1.4.1.14988.1.1.15.1.1",
      "name_col": 2,
      "columns": [
