            "9": "i18n:monitor64.snmp.poe_v_high",
            "10": "i18n:monitor64.snmp.poe_ctrl_error",
            "11": "i18n:monitor64.snmp.poe_ctrl_upgrade",
            "12": "i18n:monitor64.snmp.poe_in_detected",
            "13": "i18n:monitor64.snmp.poe_no_psu",
            "14": "i18n:monitor64.snmp.poe_ctrl_init",
