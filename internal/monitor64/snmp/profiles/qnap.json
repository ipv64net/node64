{
  "id": "qnap",
  "name": "QNAP QTS",
  "device": "nas",
  "verified": false,
  "source": "NAS-MIB (QNAP, .1.3.6.1.4.1.24681.1.2)",
  "match": {
    "object_ids": [
      ".1.3.6.1.4.1.24681",
      ".1.3.6.1.4.1.55062",
      ".1.3.6.1.4.1.8072.3.2.10"
    ],
    "descr": [
      "qnap"
    ],
    "probe": ".1.3.6.1.4.1.24681.1.2.4.0"
  },
  "scalars": [
    {
      "key": "temp:system",
      "service": "i18n:monitor64.svc.temp?name=System",
      "kind": "temp",
      "oid": ".1.3.6.1.4.1.24681.1.2.6.0",
      "metric": "temp",
      "unit": "°C",
      "rule": "temp.system",
      "leading": true,
      "min": -40,
      "max": 150
    },
    {
      "key": "temp:cpu",
      "service": "i18n:monitor64.svc.temp?name=CPU",
      "kind": "temp",
      "oid": ".1.3.6.1.4.1.24681.1.2.5.0",
      "metric": "temp",
      "unit": "°C",
      "rule": "temp.system",
      "leading": true,
      "min": -40,
      "max": 150
    }
  ],
  "tables": [
    {
      "key": "disk:{name}",
      "service": "i18n:monitor64.svc.disk?name={name}",
      "kind": "disk",
      "oid": ".1.3.6.1.4.1.24681.1.2.11.1",
      "name_col": 2,
      "columns": [
        {
          "col": 5,
          "label": "i18n:monitor64.snmp.model"
        },
        {
          "col": 3,
          "metric": "temp",
          "unit": "°C",
          "rule": "disk.temp",
          "leading": true,
          "min": -40,
          "max": 150
        },
        {
          "col": 7,
          "text": {
            "GOOD": "i18n:monitor64.snmp.smart_good",
            "Normal": "i18n:monitor64.snmp.smart_normal",
            "Warning": "i18n:monitor64.snmp.smart_warning",
            "Abnormal": "i18n:monitor64.snmp.smart_abnormal"
          },
          "fact": {
            "code": "smart_failed",
            "when_text": [
              "abnormal",
              "error",
              "fail"
            ],
            "text": "i18n:monitor64.snmp.smart_abnormal"
          }
        },
        {
          "col": 4,
          "fact": {
            "code": "smart_failed",
            "when": [
              -9
            ],
            "text": "i18n:monitor64.snmp.rw_errors"
          }
        }
      ]
    },
    {
      "key": "store:{name}",
      "service": "Volume {name}",
      "kind": "store",
      "oid": ".1.3.6.1.4.1.24681.1.2.17.1",
      "name_col": 2,
      "columns": [
        {
          "col": 6,
          "label": "Status",
          "fact": {
            "code": "raid_degraded",
            "when_text": [
              "degraded",
              "not active",
              "abnormal",
              "error"
            ],
            "text": "i18n:monitor64.snmp.volume_degraded"
          }
        }
      ]
    }
  ]
}
