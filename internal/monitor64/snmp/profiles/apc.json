      },
      "fact": {
        "code": "ups_on_battery",
        "when": [
          3
        ],
        "text": "i18n:monitor64.txt.ups_on_battery"
      }
    },
    {
      "key": "ups",
      "service": "i18n:monitor64.svc.ups_plain",
      "kind": "ups",
      "oid": ".1.3.6.1.4.1.318.1.1.1.2.2.1.0",
      "metric": "charge",
      "unit": "%",
      "min": 0,
      "max": 100
    },
    {
      "key": "ups",
      "service": "i18n:monitor64.svc.ups_plain",
      "kind": "ups",
      "oid": ".1.3.6.1.4.1.318.1.1.1.2.2.3.0",
      "metric": "runtime",
      "unit": "s",
      "factor": 0.01,
      "rule": "ups.runtime",
      "min": 0
    },
    {
      "key": "ups",
      "service": "i18n:monitor64.svc.ups_plain",
      "kind": "ups",
      "oid": ".1.3.6.1.4.1.318.1.1.1.4.2.3.0",
      "metric": "load",
      "unit": "%",
      "min": 0,
      "max": 1000
    },
    {
      "key": "ups",
      "service": "i18n:monitor64.svc.ups_plain",
      "kind": "ups",
      "oid": ".1.3.6.1.4.1.318.1.1.1.2.2.2.0",
      "metric": "battery_temp",
      "unit": "°C",
      "min": -40,
      "max": 120,
      "hide": true
    },
    {
      "key": "ups",
      "service": "i18n:monitor64.svc.ups_plain",
      "kind": "ups",
      "oid": ".1.3.6.1.4.1.318.1.1.1.3.2.1.0",
      "metric": "input_v",
      "unit": "V",
      "min": 0,
      "max": 1000,
      "hide": true
    },
    {
      "key": "ups",
      "service": "i18n:monitor64.svc.ups_plain",
      "kind": "ups",
      "oid": ".1.3.6.1.4.1.318.1.1.1.2.2.4.0",
      "fact": {
        "code": "ups_replace_battery",
        "when": [
          2
        ],
        "text": "i18n:monitor64.snmp.replace_battery"
      }
    },
    {
      "key": "ups",
      "service": "i18n:monitor64.svc.ups_plain",
      "kind": "ups",
      "oid": ".1.3.6.1.4.1.318.1.1.1.2.1.1.0",
      "fact": {
        "code": "ups_low_battery",
        "when": [
          3,
          4
        ],
        "text": "i18n:monitor64.txt.ups_low_battery"
      }
    }
  ]
}
