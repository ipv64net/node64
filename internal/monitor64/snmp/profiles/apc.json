  "source": "PowerNet-MIB (APC/Schneider, upsBasic/upsAdv)",
  "match": {
    "object_ids": [
      ".1.3.6.1.4.1.318"
    ],
    "descr": [
      "apc web/snmp",
      "network management card"
    ]
  },
  "scalars": [
    {
      "key": "ups",
      "service": "i18n:monitor64.svc.ups_plain",
      "kind": "ups",
      "oid": ".1.3.6.1.4.1.318.1.1.1.1.1.1.0",
      "label": "i18n:monitor64.snmp.model"
    },
    {
      "key": "ups",
      "service": "i18n:monitor64.svc.ups_plain",
      "kind": "ups",
      "oid": ".1.3.6.1.4.1.318.1.1.1.4.1.1.0",
      "text": {
        "1": "i18n:monitor64.txt.status_unknown",
        "2": "i18n:monitor64.txt.ups_online",
        "3": "i18n:monitor64.txt.ups_on_battery",
        "4": "Smart Boost",
        "5": "i18n:monitor64.snmp.ups_sleep",
